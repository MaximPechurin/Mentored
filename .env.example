# === PostgreSQL ===
POSTGRES_DB=mentored
POSTGRES_USER=mentored_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Mercado Pago (Checkout Pro) ===
# Your integrations -> приложение -> Credentials
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Валюта позиций в preference - должна совпадать со страной аккаунта MP
MERCADOPAGO_CURRENCY=PEN
# Webhooks -> Configure notifications -> Secret key (для проверки x-signature)
MERCADOPAGO_WEBHOOK_SECRET=
# OAuth-креды приложения, сейчас в коде не используются - про запас
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# === Почта (форма обратной связи, доступ к курсу, проверка ДЗ, магическая
#     ссылка - пароль новому покупателю) ===
# Пустой EMAIL_HOST_USER = письма просто не отправляются (но основная
# операция - заявка/оплата/проверка - никогда не падает из-за этого).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# === Публичный адрес фронта ===
# Используется там, где нужно собрать абсолютную ссылку без живого запроса
# от пользователя - например, ссылка на вход в письме новому покупателю или
# магическая ссылка товара в /admin/ (mentored/admin.py). По умолчанию уже
# правильный адрес прода - менять нужно только в деве.
SITE_URL=https://www.mentoredgroup.com
